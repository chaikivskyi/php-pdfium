root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_style = tab

[*.{m4,sh,yml}]
indent_size = 2

[*.rst]
indent_size = 3

[*.phpt]
trim_trailing_whitespace = false

[*.pdf]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

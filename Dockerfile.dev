ARG PHP_IMAGE=php:8.4-cli-trixie
FROM $PHP_IMAGE
ARG PARALLEL_VERSION=
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpng-dev libjpeg62-turbo-dev qpdf valgrind curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN if [ -n "$PARALLEL_VERSION" ]; then pecl install "parallel-$PARALLEL_VERSION"; fi
